# Copia este archivo a .env (NO lo subas a git) y completa los valores.

# Conexión a PostgreSQL (la base creada en clase, en la subred privada)
DATABASE_URL=postgresql://today_app:123456@192.168.123.23:5432/today

# Clave(s) Fernet para cifrar PII/PHI/datos crediticios y el secreto OTP.
# Generar una:  uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotar: "clave_nueva,clave_vieja" (se cifra con la primera, se descifra con cualquiera).
APP_ENCRYPTION_KEY=jhNguWmGSibd6IsHkVI_G7-Tg6f_33JieKDyYu2h8Es=

# Nombre que verá el usuario en Google Authenticator / Authy
APP_ISSUER=Today

# Rate limiting: intentos fallidos permitidos por correo dentro de la ventana
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
